{
  "compilerOptions": {
    "moduleResolution": "node",
    "target": "ES2024",
    "esModuleInterop": true,
    "rootDir": "./src",
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  }
}
